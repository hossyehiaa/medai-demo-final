// medAI Full App Schema with Auth + History
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/medai.db"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // SHA-256 hashed
  name          String?
  role          String    @default("user") // "admin" | "user" | "guest"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  queries       Query[]
}

model Query {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  query         String
  response      String    @default("")
  status        String    @default("SUCCESS") // SUCCESS | CRISIS | REFUSAL | ERROR
  citations     String    @default("[]") // JSON array
  wellnessNotes String    @default("[]") // JSON array
  createdAt     DateTime  @default(now())
  
  @@index([userId])
  @@index([createdAt])
}
